# Example .env file
# Copy this to .env and set your custom password
# Then run with: docker-compose up -d

# RabbitMQ password - will be used in both RabbitMQ and config.json
RABBITMQ_PASSWORD=your-secure-password-here 

# Let's Encrypt email address for certificate registration and renewal notifications
ACME_EMAIL=your_real_email@example.com

# Let's Encrypt domain for which to obtain the SSL certificate
API_DOMAIN=api.yourdomain.com