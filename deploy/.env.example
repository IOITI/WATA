# Example .env file
# Copy this to .env and set your custom password
# Then run with: docker-compose up -d

# RabbitMQ password - will be used in both RabbitMQ and config.json
RABBITMQ_PASSWORD=your-secure-password-here 

# Let's Encrypt email address for certificate registration and renewal notifications
ACME_EMAIL=your_real_email@example.com

# Let's Encrypt domain for which to obtain the SSL certificate
API_DOMAIN=api.yourdomain.com

# --- Admin web interface (optional) ---
# Uncomment the three lines to start it. It is served on its own domain, which
# must point to this server, and only to the addresses listed here.
# Set its password with `wataadminpasswd` after starting the application.
# COMPOSE_PROFILES=admin
# ADMIN_DOMAIN=admin.yourdomain.com
# Comma-separated, your own addresses only (add /32 to the end of single IPs).
# From a phone, whose address changes: the range of a VPN (see the README).
# ADMIN_ALLOWED_IPS=203.0.113.10/32
#
# Without a domain for it: give it the API domain on a second HTTPS port,
# https://<API_DOMAIN>:8443/. All three lines, with COMPOSE_PROFILES and
# ADMIN_ALLOWED_IPS above. 0.0.0.0 publishes the port over IPv4 only, where
# Traefik sees the caller's address.
# ADMIN_DOMAIN=api.yourdomain.com
# ADMIN_ENTRYPOINT=adminsecure
# ADMIN_PORT=0.0.0.0:8443

# --- Price recorder (optional) ---
# Keeps ten-second prices of the turbos and their index for backtesting.
# Add "recorder" to the profiles (COMPOSE_PROFILES=admin,recorder for both)
# and set trade.config.price_recorder.enabled to true in config.json.
# COMPOSE_PROFILES=recorder
